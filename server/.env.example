NODE_ENV=development

# Server
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/meeting_assistant

# JWT
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_change_this
JWT_EXPIRES_IN=7d

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Qdrant (vector database)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=500

# Email (Nodemailer - optional for Phase 3)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@meetingassistant.dev

# RAG Configuration
RAG_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
